<?xml version="1.0"?>
<package format="3">
  <name>rokae_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and conservative initial parameters for the Rokae dual-arm
    ROS 2 nodes.
  </description>

  <maintainer email="tolbayoma6@gmail.com">niic</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rokae_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
